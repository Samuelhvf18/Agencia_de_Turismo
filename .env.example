APP_NAME=Pipocas
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=agencia_turismo_db
DB_USERNAME=postgres
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="pipocasprogra@gmail.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Cuenta del administrador que crea AdminUserSeeder (obligatoria en producción)
PIPOCAS_ADMIN_EMAIL=
PIPOCAS_ADMIN_PASSWORD=

# Pasarela de pago simulada: secreto HMAC del webhook y si se notifica por HTTP (true en servidores con varios workers)
PASARELA_SECRETO=
PASARELA_WEBHOOK_HTTP=false

# n8n: URL de los webhooks (vacío = sin n8n: notificaciones por correo directo) y token compartido para los endpoints /api/n8n/*
N8N_WEBHOOK_NOTIFICACIONES=
N8N_WEBHOOK_CHATBOT=
N8N_TOKEN=

# RNF-01: forzar HTTPS (por defecto activo solo en producción) y cookie de sesión segura
FORCE_HTTPS=false
SESSION_SECURE_COOKIE=false
# RNF-12: ruta de pg_dump si no está en el PATH
PG_DUMP_PATH=pg_dump

# Gmail SMTP: activar verificación en 2 pasos y crear contraseña de aplicación.
# MAIL_MAILER=smtp
# MAIL_SCHEME=smtp
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=587
# MAIL_USERNAME=pipocasprogra@gmail.com
# MAIL_PASSWORD=  (secreto, nunca subir al repositorio)

# Google OAuth: callback exacto del cliente web registrado en Google Cloud.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=
PASSKEYS_RELYING_PARTY_ID=
# Mantener este secreto estable si se rota APP_KEY.
PASSKEYS_USER_HANDLE_SECRET=

# Vacíos hasta configurar cuentas oficiales. Solo URL HTTPS.
SOCIAL_WHATSAPP_URL=
SOCIAL_FACEBOOK_URL=
SOCIAL_INSTAGRAM_URL=
SOCIAL_TIKTOK_URL=

# Correo por Spring Boot. Vacío conserva transporte SMTP de Laravel.
# En Docker: NOTIFICACIONES_URL=http://notificaciones:8081
NOTIFICACIONES_URL=
NOTIFICACIONES_TOKEN=
NOTIFICACIONES_DB_PASSWORD=
