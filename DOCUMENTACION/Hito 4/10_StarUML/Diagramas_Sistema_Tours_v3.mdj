                {
                  "_type": "UMLNoteView",
                  "_id": "AAAAAAGIO2MK00000226",
                  "_parent": {
                    "$ref": "AAAAAAGIO2MK00000001"
                  },
                  "left": 345,
                  "top": 720,
                  "width": 260,
                  "height": 125,
                  "text": "Supuestos M/M/c/K: llegadas Poisson (\u03bb/d\u00eda), servicio exponencial \u03bc = 24/dur_hrs, c = gu\u00edas, K = cupos por salida.\nMarkov (mensual): fidelizado y perdido son absorbentes; las filas de P suman 1."
                }
