              "rightValue": "={{ $env.PIPOCAS_N8N_TOKEN }}",
              "operator": {
                "type": "string",
                "operation": "equals"
              }
            }
          ]
        },
        "options": {}
      },
      "id": "88d32fd4-d19e-58a7-a9a1-d34ad504b5c2",
