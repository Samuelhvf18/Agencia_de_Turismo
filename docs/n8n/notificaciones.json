    {
      "parameters": {
        "fromEmail": "={{ $env.PIPOCAS_MAIL_FROM }}",
        "toEmail": "={{ $json.body.datos.destino }}",
        "subject": "={{ $json.body.asunto }} · Pipocas",
        "emailFormat": "html",
        "html": "=<div style=\"font-family:Arial,sans-serif;max-width:560px;margin:auto\">\n<div style=\"background:#1F5F8B;color:#fff;padding:18px 22px;border-radius:14px 14px 0 0\"><b style=\"font-size:20px\">Pipocas</b><br>{{ $json.body.asunto }}</div>\n<div style=\"background:#fff;padding:22px;border:1px solid #eee;border-radius:0 0 14px 14px;font-size:14px;line-height:1.5\">\n<p>Hola {{ ($json.body.datos.nombre || 'viajero').split(' ')[0] }},</p>\n<p>{{ $json.body.datos.mensaje || '' }}</p>\n{{ $json.body.reserva ? '<p><b>Reserva:</b> ' + $json.body.reserva.cod + '<br><b>Tour:</b> ' + $json.body.reserva.tour + '<br><b>Fecha:</b> ' + $json.body.reserva.fecha + ' ' + $json.body.reserva.hora + '</p><p><a href=\"' + $json.body.reserva.url + '\">Ver mi reserva</a></p>' : '' }}\n<p style=\"color:#6B6F72;font-size:12px\">Mensaje automático de Pipocas Agencia de Viajes y Turismo.</p>\n</div></div>",
        "options": {}
      },
      "id": "e4ea2d8a-19c3-5a12-99e3-017b94945a19",
      "name": "Enviar correo",
      "type": "n8n-nodes-base.emailSend",
      "typeVersion": 2.1,
      "position": [
        680,
        0
      ],
      "credentials": {
        "smtp": {
          "id": "",
          "name": "SMTP Pipocas"
        }
      }
    },
    {
      "parameters": {
        "method": "POST",
        "url": "=https://graph.facebook.com/v20.0/{{ $env.WHATSAPP_PHONE_ID }}/messages",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "Authorization",
              "value": "=Bearer {{ $env.WHATSAPP_TOKEN }}"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ messaging_product: 'whatsapp', to: ($json.body.reserva?.telefono || '').replace(/\\D/g, ''), type: 'text', text: { body: $json.body.asunto + ': ' + ($json.body.datos.mensaje || '') } }) }}",
        "options": {}
      },
      "id": "233bc3f0-0946-5dc4-89f2-c210e7a7ecb8",
